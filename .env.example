# Supabase — copie este arquivo para .env.local e preencha com os valores do seu projeto.
# Encontre estes valores em: Supabase Dashboard > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# (Opcional) Usada apenas em scripts administrativos no servidor. NUNCA exponha no cliente.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui
