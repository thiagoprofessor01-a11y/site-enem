# Copie este arquivo para .env.local e preencha com os valores dos seus projetos.

# --- Supabase (Dashboard > Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Chave service_role — usada APENAS no servidor (webhook do pagamento).
# NUNCA exponha no cliente / nunca comece com NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# --- Kiwify (Painel do Kiwify > Webhooks) ---
# Token do webhook, usado para validar a assinatura das notificações de compra.
KIWIFY_WEBHOOK_TOKEN=seu-token-do-webhook-aqui
