# Copie este arquivo para .env.local e preencha com os valores dos seus projetos.

# --- Supabase (Dashboard > Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Chave service_role — usada APENAS no servidor (webhook do pagamento).
# NUNCA exponha no cliente / nunca comece com NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# --- Stripe (Dashboard da Stripe > Developers > API keys / Webhooks) ---
# Chave secreta (sk_test_... em teste, sk_live_... em produção). Só no servidor.
STRIPE_SECRET_KEY=sk_test_xxx
# Segredo de assinatura do webhook (whsec_...). Gerado ao criar o endpoint do webhook.
STRIPE_WEBHOOK_SECRET=whsec_xxx
